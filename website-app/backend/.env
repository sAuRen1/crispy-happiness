# Скопируй этот файл в .env и заполни реальными значениями.
# .env НИКОГДА не должен попадать в git — он уже в .gitignore.
# Если .env всё же закоммитится — значения в нём нужно считать
# скомпрометированными и сразу менять на новые.

# development — включает debug-режим Flask (подробные ошибки, автоперезагрузка).
# ИСПОЛЬЗУЙ ТОЛЬКО ЛОКАЛЬНО. На боевом сервере — всегда production.
FLASK_ENV=development

# Секретный ключ Flask (подписывает cookie сессии). Сгенерировать:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=7532a2bf8e91045a4fd5d8d95c0bd4be3d2c10203cff0f862e34e664593affea

# Логин администратора.
ADMIN_USERNAME=admin

# Хэш пароля администратора (НЕ сам пароль). Сгенерировать:
#   python generate_admin_hash.py
ADMIN_PASSWORD_HASH=liza2007

# Необязательно: строка подключения к БД. Если не задано — используется
# instance/ankety.db рядом с app.py.
# DATABASE_URL=sqlite:////absolute/path/to/ankety.db

# Порт для локального запуска (python app.py). На проде порт задаёт gunicorn.
PORT=5000
